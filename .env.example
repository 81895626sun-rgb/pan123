# ===========================================
# 123云盘配置 (123 Cloud Drive)
# ===========================================
# 123云盘账号（手机号）
P123_PASSPORT="13800138000"
# 123云盘密码
P123_PASSWORD="your_password_here"

# ===========================================
# 115云盘配置 (115 Cloud Drive)
# ===========================================
# 115云盘Cookie（从浏览器开发者工具获取）
# 获取方式：登录115网盘后，按F12打开开发者工具 -> Application/Storage -> Cookies
# 复制Cookie值，包含 CID、KID、SEID、UID 等字段
P115_COOKIE="CID=xxx; KID=xxx; SEID=xxx; UID=xxx"

# ===========================================
# 本地目录配置 (Local Directory)
# ===========================================
# 本地要监控的根目录（网络驱动器路径或本地路径）
# 示例1: 网络驱动器 //192.168.1.100/share
# 示例2: 本地路径 D:/Movies
local_root="//192.168.1.100/your_share/MPLink"

# 云盘前缀路径（替换local_root后的云端路径前缀）
# 例如: local_root = //192.168.1.100/share, cloud_prefix = nas/share
# 则本地文件 //192.168.1.100/share/movie/test.mp4 会转换为 nas/share/movie/test.mp4
cloud_prefix="nas/MPLink"

# 监控目录（monitor.py 入口程序会监控此目录）
# 通常与 local_root 相同
MONITOR_DIR="//192.168.1.100/your_share/MPLink"

# ===========================================
# Telegram 通知配置 (Optional)
# ===========================================
# Telegram Bot Token（从 @BotFather 获取）
# 获取方式：搜索 @BotFather -> /newbot -> 设置名称和用户名 -> 获取Token
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz"

# Telegram 聊天ID（接收通知的用户）
# 获取方式：搜索 @userinfobot -> 发送任意消息 -> 获取ID
TELEGRAM_CHAT_ID="1234567890"

# 代理服务器URL（可选，如果TG无法直连可配置）
# 格式: http://ip:port 或 http://username:password@ip:port
TELEGRAM_PROXY_URL="http://your-proxy-ip:7890/"

# ===========================================
# QMediaSync 同步配置 (Optional)
# ===========================================
# 上传完成后触发的 QMediaSync 同步任务地址和密钥
QMEDIASYNC_BASE_URL="http://your-qmediasync-host:port"
QMEDIASYNC_API_KEY="your_qmediasync_api_key"
# 要触发的同步目录 ID 列表 (逗号分隔, 例如 1=movie 2=teleplay)
QMEDIASYNC_PATH_IDS="1,2"
# 防抖延迟（秒）：最后一个文件就绪后等待多少秒再触发同步（默认 120）
QMEDIASYNC_DEBOUNCE_SECONDS=120
